#include <tunables/global>

profile docker-node-hardened flags=(attach_disconnected,mediate_deleted) {
  # Base kernel abstractions
  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Allow all network operations
  network,

  # "Blacklist" approach, for teaching purposes:
  # allow reading everything the Node.js runtime needs...
  file,

  # ...BUT explicitly deny reading the sensitive files.
  # If the app tries to read them via LFI, the Linux kernel blocks the syscall (EACCES).
  # NOTE: /etc/come-to-code.conf is intentionally NOT listed here -> the blacklist
  #       "forgets" it, which is exactly the point we make on stage.
  deny /etc/passwd mrw,
  deny /etc/shadow mrw,
  deny /var/run/secrets/kubernetes.io/serviceaccount/** mrw,

  # Also block dangerous system operations
  deny mount,
  deny ptrace,
}
